---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PostList from "../components/PostList.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-label="Ingus Lab">
				<div class="hero-content">
					<img class="hero-logo" src="/images/inguslab-logo.png" alt="" width="112" height="112" />
					<p>Research notes for curious builders</p>
					<h1>Ingus Lab</h1>
					<p>
						<span data-lang="ko">
							논문을 읽고, 기술 트렌드를 관찰하며, AI와 로보틱스에서 반복해서 쓰이는 핵심 개념을 정리하는 개인 연구 노트입니다.
						</span>
						<span data-lang="en">
							A personal research notebook for reading papers, tracking technology trends, and building background knowledge in AI and robotics.
						</span>
					</p>
				</div>
			</section>
			<section class="sections">
				<a href="/papers">
					<span class="section-title" data-lang="ko">논문</span>
					<span class="section-title" data-lang="en">Papers</span>
					<span data-lang="ko">논문과 연구 자료에서 얻은 질문, 방법론, 실험 아이디어를 정리합니다.</span>
					<span data-lang="en">Notes on research papers, methods, and experiment ideas worth carrying forward.</span>
				</a>
				<a href="/trends">
					<span class="section-title" data-lang="ko">트렌드</span>
					<span class="section-title" data-lang="en">Trends</span>
					<span data-lang="ko">AI, 제품, 개발 도구, 시장 변화에서 다음 실험으로 이어질 신호를 기록합니다.</span>
					<span data-lang="en">Signals from AI, product, developer-tool, and market changes.</span>
				</a>
				<a href="/concept">
					<span class="section-title" data-lang="ko">Background</span>
					<span class="section-title" data-lang="en">Background</span>
					<span data-lang="ko">AI와 로보틱스를 이해하는 데 필요한 배경 지식, 개념, 방법론을 정리합니다.</span>
					<span data-lang="en">Background notes on concepts, methods, and context for understanding AI and robotics.</span>
				</a>
			</section>
			<section>
				<h2>
					<span data-lang="ko">최근 노트</span>
					<span data-lang="en">Latest Notes</span>
				</h2>
				<PostList posts={posts} />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		align-items: center;
		background:
			linear-gradient(90deg, rgba(12, 18, 28, 0.86), rgba(12, 18, 28, 0.42) 45%, rgba(12, 18, 28, 0.08)),
			url("/images/hero-ai-robotics-fusion.png") center / cover no-repeat;
		display: flex;
		margin: -3em calc(50% - 50vw) 3rem;
		min-height: clamp(360px, 56vw, 560px);
		padding: 4rem max(2rem, calc((100vw - 720px) / 2 + 1rem));
	}
	.hero-content {
		max-width: 620px;
	}
	.hero-logo {
		border-radius: 24px;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
		display: block;
		height: 112px;
		margin-bottom: 1.25rem;
		object-fit: cover;
		width: 112px;
	}
	.hero-content > p:first-child {
		color: #8ee7ff;
		font-size: 0.85em;
		font-weight: 700;
		margin-bottom: 0.5rem;
		text-transform: uppercase;
	}
	.hero h1 {
		color: #fff;
		font-size: clamp(3rem, 9vw, 5.4rem);
		margin-bottom: 0.5rem;
	}
	.hero-content > p:last-child {
		color: rgba(255, 255, 255, 0.9);
		font-size: 1.1em;
		line-height: 1.6;
		max-width: 560px;
	}
	.sections {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(3, 1fr);
		margin-bottom: 3rem;
	}
	.sections a {
		border-top: 3px solid var(--accent);
		color: rgb(var(--gray-dark));
		display: block;
		padding-top: 0.75rem;
		text-decoration: none;
	}
	.sections .section-title {
		color: rgb(var(--black));
		display: block;
		font-size: 1.25em;
		font-weight: 700;
		margin-bottom: 0.35rem;
	}
	@media (max-width: 720px) {
		.hero {
			background:
				linear-gradient(180deg, rgba(12, 18, 28, 0.88), rgba(12, 18, 28, 0.48)),
				url("/images/hero-ai-robotics-fusion.png") 62% center / cover no-repeat;
			margin-top: -1em;
			min-height: 420px;
			padding: 3rem 1rem;
		}
		.hero-logo {
			height: 88px;
			width: 88px;
		}
		.sections {
			grid-template-columns: 1fr;
		}
	}
</style>
