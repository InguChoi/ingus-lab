---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PostList from "../components/PostList.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p>Research notes for curious builders</p>
				<h1>Ingus Lab</h1>
				<p>
					<span data-lang="ko">
						논문을 읽고, 기술 트렌드를 관찰하고, AI와 로봇에서 반복해서 쓰이는 핵심 개념을 정리하는 개인 연구 노트입니다.
					</span>
					<span data-lang="en">
						A personal research notebook for reading papers, tracking technology trends, and reviewing core concepts in AI and robotics.
					</span>
				</p>
			</section>
			<section class="sections">
				<a href="/papers">
					<span class="section-title" data-lang="ko">논문</span>
					<span class="section-title" data-lang="en">Papers</span>
					<span data-lang="ko">논문과 연구 자료에서 핵심 질문, 방법론, 실험 아이디어를 정리합니다.</span>
					<span data-lang="en">Notes on research papers, methods, and experiment ideas worth carrying forward.</span>
				</a>
				<a href="/trends">
					<span class="section-title" data-lang="ko">트렌드</span>
					<span class="section-title" data-lang="en">Trends</span>
					<span data-lang="ko">AI, 제품, 개발 도구, 시장 변화에서 다음 실험으로 이어질 신호를 기록합니다.</span>
					<span data-lang="en">Signals from AI, product, developer-tool, and market changes.</span>
				</a>
				<a href="/concept">
					<span class="section-title" data-lang="ko">기술 개념</span>
					<span class="section-title" data-lang="en">Technical Concepts</span>
					<span data-lang="ko">AI와 로봇에서 전반적으로 쓰이는 기술, 개념, 방법론을 리뷰합니다.</span>
					<span data-lang="en">Reviews of technologies, concepts, and methods used across AI and robotics.</span>
				</a>
			</section>
			<section>
				<h2>
					<span data-lang="ko">최근 노트</span>
					<span data-lang="en">Latest Notes</span>
				</h2>
				<PostList posts={posts} />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 3rem;
	}
	.hero > p:first-child {
		color: var(--accent);
		font-size: 0.85em;
		font-weight: 700;
		margin-bottom: 0.5rem;
		text-transform: uppercase;
	}
	.hero h1 {
		font-size: 3.5em;
		margin-bottom: 0.5rem;
	}
	.sections {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(3, 1fr);
		margin-bottom: 3rem;
	}
	.sections a {
		border-top: 3px solid var(--accent);
		color: rgb(var(--gray-dark));
		display: block;
		padding-top: 0.75rem;
		text-decoration: none;
	}
	.sections .section-title {
		color: rgb(var(--black));
		display: block;
		font-size: 1.25em;
		font-weight: 700;
		margin-bottom: 0.35rem;
	}
	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2.5em;
		}
		.sections {
			grid-template-columns: 1fr;
		}
	}
</style>
