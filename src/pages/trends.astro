---
import { getCollection } from "astro:content";
import SectionPage from "../components/SectionPage.astro";

const posts = (await getCollection("blog", ({ data }) => data.category === "trends")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SectionPage
	title="Trends"
	description="AI, 제품, 개발 도구, 시장의 변화를 관찰하고 다음 실험으로 이어질 신호를 기록합니다."
	titleKo="트렌드"
	titleEn="Trends"
	descriptionKo="AI, 제품, 개발 도구, 시장의 변화를 관찰하고 다음 실험으로 이어질 신호를 기록합니다."
	descriptionEn="Observations on AI, products, developer tools, and market shifts that may lead to the next experiment."
	posts={posts}
/>
