---
import { getCollection } from "astro:content";
import SectionPage from "../components/SectionPage.astro";

const posts = (await getCollection("blog", ({ data }) => data.category === "concept")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SectionPage
	title="Background"
	description="AI와 로봇을 이해하는 데 필요한 배경 지식, 핵심 개념, 방법론을 정리합니다."
	titleKo="배경지식"
	titleEn="Background"
	descriptionKo="AI와 로봇을 이해하는 데 필요한 배경 지식, 핵심 개념, 방법론을 정리합니다."
	descriptionEn="Background notes on core ideas, methods, and context for understanding AI and robotics."
	posts={posts}
/>
