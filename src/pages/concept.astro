---
import { getCollection } from "astro:content";
import SectionPage from "../components/SectionPage.astro";

const posts = (await getCollection("blog", ({ data }) => data.category === "concept")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SectionPage
	title="Technical Concepts"
	description="AI와 로봇 분야에서 반복해서 쓰이는 핵심 기술, 개념, 방법론을 정리합니다."
	titleKo="기술 개념"
	titleEn="Technical Concepts"
	descriptionKo="AI와 로봇 분야에서 반복해서 쓰이는 핵심 기술, 개념, 방법론을 정리합니다."
	descriptionEn="Reviews of core technologies, concepts, and methods used across AI and robotics."
	posts={posts}
/>
