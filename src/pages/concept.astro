---
import { getCollection } from "astro:content";
import SectionPage from "../components/SectionPage.astro";

const posts = (await getCollection("blog", ({ data }) => data.category === "concept")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SectionPage
	title="Concept"
	description="제품, 인터페이스, 학습 방식에 대한 초기 가설과 아직 실험 중인 개념을 모읍니다."
	posts={posts}
/>
