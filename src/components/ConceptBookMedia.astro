---
import type { ConceptBookMediaItem } from "../data/conceptBookMedia";

interface Props {
	items?: ConceptBookMediaItem[];
}

const { items = [] } = Astro.props;
---

{
	items.length > 0 && (
		<section class="paper-media-section" aria-labelledby="paper-media-heading">
			<div class="paper-media-heading">
				<p>Paper Media</p>
				<h2 id="paper-media-heading">관련 논문 미디어</h2>
			</div>
			<div class="paper-media-grid">
				{items.map((item) => (
					<article class="paper-media-card">
						{item.imageUrl && (
							<a class="paper-media-image" href={item.sourceUrl} rel="noreferrer" target="_blank">
								<img src={item.imageUrl} alt={item.imageAlt ?? `${item.title} representative media`} loading="lazy" />
							</a>
						)}
						<div class="paper-media-copy">
							<h3>{item.title}</h3>
							<p>
								<a href={item.paperUrl} rel="noreferrer" target="_blank">Paper</a>
								<span> / </span>
								<a href={item.sourceUrl} rel="noreferrer" target="_blank">Official media source</a>
							</p>
							{item.note && <p class="paper-media-note">{item.note}</p>}
						</div>
						{
							item.youtubeId ? (
								<div class="paper-video-embed">
									<iframe
										src={`https://www.youtube.com/embed/${item.youtubeId}`}
										title={`${item.title} video`}
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
										allowfullscreen
										loading="lazy"
									/>
								</div>
							) : (
								item.videoUrl && (
									<a class="paper-video-link" href={item.videoUrl} rel="noreferrer" target="_blank">
										공식 데모/비디오 페이지 열기
									</a>
								)
							)
						}
					</article>
				))}
			</div>
		</section>
	)
}

<style>
	.paper-media-section {
		border-top: 1px solid rgb(var(--gray-light));
		margin-top: 3rem;
		padding-top: 2rem;
	}
	.paper-media-heading p {
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
		text-transform: uppercase;
	}
	.paper-media-heading h2 {
		font-size: 1.45rem;
		margin-bottom: 1rem;
	}
	.paper-media-grid {
		display: grid;
		gap: 1rem;
	}
	.paper-media-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		display: grid;
		gap: 1rem;
		padding: 1rem;
	}
	.paper-media-image {
		background: #f7f8fb;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		display: block;
		overflow-x: auto;
	}
	.paper-media-image img {
		border: 0;
		border-radius: 0;
		display: block;
		margin: 0 auto;
		max-height: 360px;
		object-fit: contain;
		width: 100%;
	}
	.paper-media-copy h3 {
		font-size: 1.05rem;
		margin-bottom: 0.35rem;
	}
	.paper-media-copy p {
		font-size: 0.9rem;
		line-height: 1.55;
		margin: 0;
	}
	.paper-media-note {
		color: rgb(var(--gray));
		margin-top: 0.5rem !important;
	}
	.paper-video-embed {
		aspect-ratio: 16 / 9;
		background: #f7f8fb;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		overflow: hidden;
	}
	.paper-video-embed iframe {
		border: 0;
		display: block;
		height: 100%;
		width: 100%;
	}
	.paper-video-link {
		align-self: start;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		color: rgb(var(--black));
		display: inline-block;
		font-size: 0.9rem;
		font-weight: 700;
		padding: 0.65rem 0.85rem;
		text-decoration: none;
	}
	.paper-video-link:hover {
		color: var(--accent);
	}
</style>
