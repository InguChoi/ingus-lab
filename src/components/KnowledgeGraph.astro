---
import type { CollectionEntry } from "astro:content";

interface Props {
	posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const taggedPosts = posts
	.filter((post) => post.data.tags && post.data.tags.length > 0)
	.map((post) => ({
		id: post.id,
		titleKo: post.data.titleKo ?? post.data.title,
		titleEn: post.data.titleEn ?? post.data.title,
		tags: post.data.tags ?? [],
	}));

const tagCounts = new Map<string, number>();
taggedPosts.forEach((post) => {
	post.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
});

const tags = [...tagCounts.entries()]
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
	.map(([name, count]) => ({ name, count }));

const width = 960;
const tagColumns = Math.min(4, Math.max(1, Math.ceil(Math.sqrt(tags.length))));
const postColumns = Math.min(3, Math.max(1, taggedPosts.length));
const tagRows = Math.max(1, Math.ceil(tags.length / tagColumns));
const postRows = Math.max(1, Math.ceil(taggedPosts.length / postColumns));
const tagStartY = 78;
const tagGapY = 86;
const postStartY = tagStartY + tagRows * tagGapY + 80;
const height = postStartY + postRows * 112 + 34;
const palette = ["#0ea5e9", "#14b8a6", "#f59e0b", "#6366f1", "#ef4444", "#22c55e"];

const tagNodes = tags.map((tag, index) => {
	const col = index % tagColumns;
	const row = Math.floor(index / tagColumns);
	const x = tagColumns === 1 ? width / 2 : 92 + col * ((width - 184) / (tagColumns - 1));
	const y = tagStartY + row * tagGapY;
	return { ...tag, x, y, color: palette[index % palette.length] };
});

const postNodes = taggedPosts.map((post, index) => {
	const col = index % postColumns;
	const row = Math.floor(index / postColumns);
	const x = postColumns === 1 ? width / 2 : 142 + col * ((width - 284) / (postColumns - 1));
	const y = postStartY + row * 112;
	return { ...post, x, y };
});

const tagNodeByName = new Map(tagNodes.map((tag) => [tag.name, tag]));
const links = postNodes.flatMap((post) =>
	post.tags
		.map((tag) => {
			const tagNode = tagNodeByName.get(tag);
			if (!tagNode) return null;
			return {
				tag,
				color: tagNode.color,
				x1: tagNode.x,
				y1: tagNode.y + 25,
				x2: post.x,
				y2: post.y - 34,
			};
		})
		.filter(Boolean),
);

const truncate = (value: string, length: number) =>
	value.length > length ? `${value.slice(0, length - 1)}…` : value;
---

{taggedPosts.length > 0 && (
	<section class="knowledge-graph" aria-labelledby="knowledge-graph-title">
		<div class="graph-heading">
			<div>
				<p>Knowledge Graph</p>
				<h2 id="knowledge-graph-title">
					<span data-lang="ko">글과 배경지식의 연결</span>
					<span data-lang="en">Connections Across Notes</span>
				</h2>
			</div>
			<p>
				<span data-lang="ko">키워드 태그가 같은 글들을 연결해, Ingus Lab의 관심사가 어디에서 겹치는지 보여줍니다.</span>
				<span data-lang="en">Shared keyword tags reveal where Ingus Lab notes overlap and reinforce each other.</span>
			</p>
		</div>
		<div class="graph-scroll" role="img" aria-label="Knowledge graph of notes and keyword tags">
			<svg viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
				<defs>
					<filter id="node-shadow" x="-20%" y="-20%" width="140%" height="140%">
						<feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#0f172a" flood-opacity="0.14" />
					</filter>
				</defs>
				{links.map((link) => (
					<path
						d={`M ${link.x1} ${link.y1} C ${link.x1} ${(link.y1 + link.y2) / 2}, ${link.x2} ${(link.y1 + link.y2) / 2}, ${link.x2} ${link.y2}`}
						fill="none"
						stroke={link.color}
						stroke-width="2"
						stroke-opacity="0.28"
					/>
				))}
				{tagNodes.map((tag) => (
					<g transform={`translate(${tag.x} ${tag.y})`}>
						<circle r="26" fill={tag.color} fill-opacity="0.12" stroke={tag.color} stroke-width="2" />
						<text y="-2" text-anchor="middle" class="tag-label">#{truncate(tag.name, 18)}</text>
						<text y="16" text-anchor="middle" class="tag-count">
							{tag.count} note{tag.count > 1 ? "s" : ""}
						</text>
						<title>#{tag.name}</title>
					</g>
				))}
				{postNodes.map((post) => (
					<a href={`/blog/${post.id}/`}>
						<g transform={`translate(${post.x} ${post.y})`} class="post-node">
							<rect x="-122" y="-34" width="244" height="68" rx="8" filter="url(#node-shadow)" />
							<text y="-6" text-anchor="middle" class="post-title">
								<tspan data-lang="ko">{truncate(post.titleKo, 23)}</tspan>
								<tspan data-lang="en">{truncate(post.titleEn, 23)}</tspan>
							</text>
							<text y="16" text-anchor="middle" class="post-tags">{post.tags.slice(0, 2).map((tag) => `#${tag}`).join(" ")}</text>
							<title>{post.titleKo}</title>
						</g>
					</a>
				))}
			</svg>
		</div>
	</section>
)}

<style>
	.knowledge-graph {
		margin: 0 0 3rem;
	}
	.graph-heading {
		align-items: end;
		display: grid;
		gap: 1rem;
		grid-template-columns: minmax(0, 0.9fr) minmax(260px, 1.1fr);
		margin-bottom: 1rem;
	}
	.graph-heading p {
		color: rgb(var(--gray));
		margin: 0;
	}
	.graph-heading > div > p {
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0;
		margin-bottom: 0.25rem;
		text-transform: uppercase;
	}
	.graph-heading h2 {
		margin: 0;
	}
	.graph-scroll {
		border-top: 1px solid rgb(var(--gray-light));
		overflow-x: auto;
		padding-top: 1rem;
	}
	svg {
		display: block;
		min-width: 760px;
		width: 100%;
	}
	.tag-label,
	.post-title {
		fill: rgb(var(--black));
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 800;
	}
	.tag-count,
	.post-tags {
		fill: rgb(var(--gray));
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 700;
	}
	.post-node rect {
		fill: #fff;
		stroke: rgb(var(--gray-light));
		stroke-width: 1;
	}
	.post-node:hover rect {
		stroke: var(--accent);
		stroke-width: 2;
	}
	.post-node:hover .post-title {
		fill: var(--accent);
	}
	:global(html[data-lang="ko"] .post-title [data-lang="en"]),
	:global(html[data-lang="en"] .post-title [data-lang="ko"]) {
		display: none;
	}
	@media (max-width: 720px) {
		.graph-heading {
			align-items: start;
			grid-template-columns: 1fr;
		}
		.graph-scroll {
			margin-right: -1rem;
			padding-right: 1rem;
		}
	}
</style>
