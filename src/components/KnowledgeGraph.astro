---
import type { CollectionEntry } from "astro:content";

interface Props {
	posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const taggedPosts = posts
	.filter((post) => post.data.tags && post.data.tags.length > 0)
	.map((post) => ({
		id: post.id,
		titleKo: post.data.titleKo ?? post.data.title,
		titleEn: post.data.titleEn ?? post.data.title,
		url: `/blog/${post.id}/`,
		tags: post.data.tags ?? [],
	}));

const tagCounts = new Map<string, number>();
taggedPosts.forEach((post) => {
	post.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
});

const tags = [...tagCounts.entries()]
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
	.map(([name, count]) => ({ name, count }));

const palette = ["#0ea5e9", "#14b8a6", "#f59e0b", "#6366f1", "#ef4444", "#22c55e"];
const tagNodes = tags.map((tag, index) => {
	const angle = (Math.PI * 2 * index) / Math.max(tags.length, 1) - Math.PI / 2;
	const radius = 1.08;
	return {
		id: `tag:${tag.name}`,
		type: "tag",
		labelKo: `#${tag.name}`,
		labelEn: `#${tag.name}`,
		tag: tag.name,
		count: tag.count,
		x: Math.cos(angle) * radius,
		y: Math.sin(angle) * radius,
		size: 7 + tag.count * 2,
		color: palette[index % palette.length],
	};
});

const postNodes = taggedPosts.map((post, index) => {
	const angle = (Math.PI * 2 * index) / Math.max(taggedPosts.length, 1) + Math.PI / 2;
	const radius = 0.35;
	return {
		id: `post:${post.id}`,
		type: "post",
		labelKo: post.titleKo,
		labelEn: post.titleEn,
		url: post.url,
		tags: post.tags,
		x: Math.cos(angle) * radius,
		y: Math.sin(angle) * radius,
		size: 12,
		color: "#111827",
	};
});

const links = taggedPosts.flatMap((post) =>
	post.tags.map((tag) => ({
		id: `${post.id}:${tag}`,
		source: `post:${post.id}`,
		target: `tag:${tag}`,
		tag,
	})),
);

const graphData = {
	nodes: [...tagNodes, ...postNodes],
	edges: links,
};
---

{taggedPosts.length > 0 && (
	<section class="knowledge-graph" aria-labelledby="knowledge-graph-title">
		<div class="graph-heading">
			<div>
				<p>Knowledge Graph</p>
				<h2 id="knowledge-graph-title">
					<span data-lang="ko">글과 배경지식의 연결</span>
					<span data-lang="en">Connections Across Notes</span>
				</h2>
			</div>
			<p>
				<span data-lang="ko">Sigma.js로 키워드 태그와 글 사이의 연결을 시각화합니다. 글 노드를 클릭하면 해당 노트로 이동합니다.</span>
				<span data-lang="en">Sigma.js visualizes the links between keyword tags and notes. Click a note node to open it.</span>
			</p>
		</div>
		<div class="graph-shell">
			<div class="graph-legend" aria-hidden="true">
				<span><i class="post-dot"></i> Notes</span>
				<span><i class="tag-dot"></i> #keywords</span>
			</div>
			<div class="sigma-graph" data-knowledge-graph></div>
			<script type="application/json" data-knowledge-graph-data set:html={JSON.stringify(graphData)} />
			<noscript>
				<ul class="graph-fallback">
					{taggedPosts.map((post) => (
						<li>
							<a href={post.url}>{post.titleKo}</a>: {post.tags.map((tag) => `#${tag}`).join(" ")}
						</li>
					))}
				</ul>
			</noscript>
		</div>
	</section>
)}

<script>
	import Graph from "graphology";
	import Sigma from "sigma";

	const containers = document.querySelectorAll<HTMLElement>("[data-knowledge-graph]");

	containers.forEach((container) => {
		const dataScript = container.parentElement?.querySelector<HTMLScriptElement>(
			"[data-knowledge-graph-data]",
		);
		if (!dataScript?.textContent) return;

		const data = JSON.parse(dataScript.textContent) as {
			nodes: Array<{
				id: string;
				type: "post" | "tag";
				labelKo: string;
				labelEn: string;
				url?: string;
				x: number;
				y: number;
				size: number;
				color: string;
			}>;
			edges: Array<{ id: string; source: string; target: string; tag: string }>;
		};

		const graph = new Graph();
		const getLanguage = () => document.documentElement.dataset.lang === "en" ? "en" : "ko";
		const applyLabels = () => {
			const language = getLanguage();
			graph.forEachNode((node, attributes) => {
				graph.setNodeAttribute(
					node,
					"label",
					language === "en" ? attributes.labelEn : attributes.labelKo,
				);
			});
		};

		data.nodes.forEach((node) => {
			graph.addNode(node.id, {
				...node,
				label: getLanguage() === "en" ? node.labelEn : node.labelKo,
			});
		});

		data.edges.forEach((edge) => {
			if (graph.hasNode(edge.source) && graph.hasNode(edge.target)) {
				graph.addEdgeWithKey(edge.id, edge.source, edge.target, {
					color: "#94a3b8",
					size: 1.4,
					tag: edge.tag,
				});
			}
		});

		const renderer = new Sigma(graph, container, {
			allowInvalidContainer: true,
			defaultEdgeColor: "#94a3b8",
			defaultNodeColor: "#111827",
			edgeColor: "default",
			labelColor: { color: "#111827" },
			labelDensity: 0.12,
			labelRenderedSizeThreshold: 8,
			renderEdgeLabels: false,
			zIndex: true,
		});

		renderer.on("clickNode", ({ node }) => {
			const url = graph.getNodeAttribute(node, "url") as string | undefined;
			if (url) window.location.href = url;
		});

		renderer.on("enterNode", ({ node }) => {
			container.style.cursor = graph.getNodeAttribute(node, "type") === "post" ? "pointer" : "default";
		});

		renderer.on("leaveNode", () => {
			container.style.cursor = "grab";
		});

		const observer = new MutationObserver(() => {
			applyLabels();
			renderer.refresh();
		});
		observer.observe(document.documentElement, {
			attributeFilter: ["data-lang"],
			attributes: true,
		});
	});
</script>

<style>
	.knowledge-graph {
		margin: 0 0 3rem;
	}
	.graph-heading {
		align-items: end;
		display: grid;
		gap: 1rem;
		grid-template-columns: minmax(0, 0.9fr) minmax(260px, 1.1fr);
		margin-bottom: 1rem;
	}
	.graph-heading p {
		color: rgb(var(--gray));
		margin: 0;
	}
	.graph-heading > div > p {
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0;
		margin-bottom: 0.25rem;
		text-transform: uppercase;
	}
	.graph-heading h2 {
		margin: 0;
	}
	.graph-shell {
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1rem;
	}
	.graph-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}
	.graph-legend span {
		align-items: center;
		color: rgb(var(--gray));
		display: inline-flex;
		font-size: 0.82rem;
		font-weight: 700;
		gap: 0.4rem;
	}
	.graph-legend i {
		border-radius: 999px;
		display: inline-block;
		height: 0.75rem;
		width: 0.75rem;
	}
	.post-dot {
		background: #111827;
	}
	.tag-dot {
		background: #0ea5e9;
	}
	.sigma-graph {
		background:
			linear-gradient(180deg, rgba(248, 250, 252, 0.86), rgba(255, 255, 255, 0.98)),
			radial-gradient(circle at 20% 20%, rgba(14, 165, 233, 0.12), transparent 32%);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		cursor: grab;
		height: clamp(420px, 54vw, 620px);
		overflow: hidden;
		width: 100%;
	}
	.graph-fallback {
		margin: 1rem 0 0;
	}
	@media (max-width: 720px) {
		.graph-heading {
			align-items: start;
			grid-template-columns: 1fr;
		}
		.sigma-graph {
			height: 460px;
		}
	}
</style>
