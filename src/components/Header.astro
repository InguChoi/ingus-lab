---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2>
			<a class="brand" href="/" aria-label={SITE_TITLE}>
				<img src="/images/inguslab-logo.png" alt="" width="40" height="40" />
				<span>{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">
				<span data-lang="ko">홈</span>
				<span data-lang="en">Home</span>
			</HeaderLink>
			<HeaderLink href="/papers">
				<span data-lang="ko">논문</span>
				<span data-lang="en">Papers</span>
			</HeaderLink>
			<HeaderLink href="/trends">
				<span data-lang="ko">트렌드</span>
				<span data-lang="en">Trends</span>
			</HeaderLink>
			<HeaderLink href="/concept">
				<span data-lang="ko">배경지식</span>
				<span data-lang="en">Background</span>
			</HeaderLink>
			<HeaderLink href="/lecture">
				<span data-lang="ko">강의</span>
				<span data-lang="en">Lecture</span>
			</HeaderLink>
		</div>
		<div class="language-switch" aria-label="Language">
			<button type="button" data-set-lang="ko" aria-pressed="true">한국어</button>
			<button type="button" data-set-lang="en" aria-pressed="false">EN</button>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand {
		align-items: center;
		color: rgb(var(--black));
		display: inline-flex;
		gap: 0.65rem;
		padding: 0.55rem 0.5rem 0.55rem 0;
	}
	.brand img {
		border-radius: 10px;
		display: block;
		height: 40px;
		object-fit: cover;
		width: 40px;
	}
	.brand span {
		white-space: nowrap;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25em;
	}
	.language-switch {
		display: inline-flex;
		gap: 0.25rem;
		margin-left: 0.5rem;
		padding: 0.2rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: #fff;
	}
	.language-switch button {
		min-width: 3.25rem;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: rgb(var(--gray));
		cursor: pointer;
		font: inherit;
		font-size: 0.8rem;
		font-weight: 700;
		line-height: 1;
		padding: 0.55rem 0.75rem;
	}
	:global(html[data-lang="ko"] .language-switch button[data-set-lang="ko"]),
	:global(html[data-lang="en"] .language-switch button[data-set-lang="en"]) {
		background: rgb(var(--black));
		color: #fff;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 860px) {
		nav {
			align-items: flex-start;
			flex-direction: column;
			padding: 0.75em 0;
		}
		.language-switch {
			margin: 0.5rem 0 0;
		}
		nav a {
			padding: 0.35em 0.5em;
		}
	}
</style>
