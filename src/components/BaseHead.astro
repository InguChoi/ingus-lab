---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	heroImage?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, heroImage } = Astro.props;
const socialImage = heroImage ?? image ?? "/images/hero-ai-robotics-fusion.png";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<script is:inline>
	const setIngusLanguage = (language) => {
		document.documentElement.dataset.lang = language;
		document.documentElement.lang = language === "ko" ? "ko" : "en";
		localStorage.setItem("ingus-language", language);
		document.querySelectorAll("[data-set-lang]").forEach((button) => {
			button.setAttribute("aria-pressed", String(button.dataset.setLang === language));
		});
	};
	const savedLanguage = localStorage.getItem("ingus-language");
	const browserLanguage = navigator.language?.toLowerCase().startsWith("ko") ? "ko" : "en";
	setIngusLanguage(savedLanguage || browserLanguage);
	document.addEventListener("DOMContentLoaded", () => {
		document.querySelectorAll("[data-set-lang]").forEach((button) => {
			button.addEventListener("click", () => setIngusLanguage(button.dataset.setLang));
		});
		setIngusLanguage(document.documentElement.dataset.lang || "ko");
	});
</script>
<link rel="icon" type="image/png" href="/images/inguslab-logo.png" />
<link rel="apple-touch-icon" href="/images/inguslab-logo.png" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(socialImage, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(socialImage, Astro.url)} />
