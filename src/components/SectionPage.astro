---
import type { CollectionEntry } from "astro:content";
import BaseHead from "./BaseHead.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import PostList from "./PostList.astro";
import { SITE_TITLE } from "../consts";

interface Props {
	title: string;
	description: string;
	titleKo?: string;
	titleEn?: string;
	descriptionKo?: string;
	descriptionEn?: string;
	posts: CollectionEntry<"blog">[];
}

const { title, description, titleKo, titleEn, descriptionKo, descriptionEn, posts } = Astro.props;
const hasIntroContent = Astro.slots.has("default");
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-heading">
				<p>Ingus Lab</p>
				<h1>
					<span data-lang="ko">{titleKo ?? title}</span>
					<span data-lang="en">{titleEn ?? title}</span>
				</h1>
				<p>
					<span data-lang="ko">{descriptionKo ?? description}</span>
					<span data-lang="en">{descriptionEn ?? description}</span>
				</p>
			</section>
			<slot />
			{(posts.length > 0 || !hasIntroContent) && <PostList posts={posts} />}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-heading {
		margin-bottom: 2.5rem;
	}
	.page-heading > p:first-child {
		color: var(--accent);
		font-size: 0.85em;
		font-weight: 700;
		letter-spacing: 0;
		margin-bottom: 0.5rem;
		text-transform: uppercase;
	}
	.page-heading h1 {
		margin-bottom: 0.75rem;
	}
</style>
